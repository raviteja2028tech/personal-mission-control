# ===================================================
# PERSONAL MISSION CONTROL — Server Environment Config
# ===================================================

# Server Port (Render sets this automatically)
PORT=5000

# Environment Mode (production | development)
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pmc?retryWrites=true&w=majority

# Security Keys (Generate strong 32+ character strings)
JWT_SECRET=replace_with_strong_production_jwt_secret_key_32chars
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_key
JWT_EXPIRE=7d

# Frontend Origin for CORS & Cookie Domain
CLIENT_URL=https://personal-mission-control-7269a.web.app

# Optional Integrations
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
